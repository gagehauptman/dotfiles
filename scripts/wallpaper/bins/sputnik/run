#!/bin/sh
# Sputnik 1 in its real orbit is a scene of the warm wallpaper renderer in
# ../spinning_globe, which it shares with the globe, the shuttle and the free
# return (layers, hide/show, GPU setup); its scene itself is ./scene
# (sputnik_scene).
dir=$(dirname "$(realpath "$0")")/../spinning_globe
bin=$dir/target/release/layer_shell_bevy
# Always through cargo (a no-op when it is up to date) so a scene edited or
# pulled since the last build isn't shown from a stale binary; if the build
# fails, the last good one still runs.
cargo build --release --quiet --manifest-path "$dir/Cargo.toml" >&2 || [ -x "$bin" ] || exit 1
exec "$bin" --scene sputnik "$@"
