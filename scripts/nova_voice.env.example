# Voice assistant (SUPER+T) — per-device settings, loaded by scripts/nova_voice.sh.
# Copy to ~/.config/nova-voice/env (outside the repo; `nova_voice.sh setup` does
# it) and fill in. Only the first two are required.

# openclaw gateway (chat completions endpoint and its bearer token)
NOVA_GATEWAY_URL=https://gateway.example.net
NOVA_GATEWAY_TOKEN=

# Identity: notification/log name, and how this machine introduces itself
#NOVA_NAME=Nova
#NOVA_DEVICE=my-desktop           # default: hostname
#NOVA_AGENT=main                  # gateway agent id
#NOVA_MODEL=                      # e.g. anthropic/claude-sonnet-5; empty = gateway default
#NOVA_BRIEF=1                     # ask for short spoken replies

# Speech to text: a local whisper-server (whisper.cpp) and its model for the CLI fallback
#NOVA_WHISPER_URL=http://127.0.0.1:8178/inference
#NOVA_WHISPER_MODEL=~/.local/share/whisper/ggml-base.en.bin

# Text to speech: auto tries elevenlabs, then the gateway relay, then piper
#NOVA_TTS=auto                    # auto | elevenlabs | gateway | piper
#NOVA_ELEVENLABS_API_KEY=
#NOVA_ELEVENLABS_VOICE=           # voice id (required with the key)
#NOVA_ELEVENLABS_MODEL=eleven_flash_v2_5
#NOVA_GATEWAY_SSH=                # ssh host that runs openclaw, for `gateway call tts.speak`
#NOVA_GATEWAY_CLI=openclaw        # openclaw binary on that host
#NOVA_PIPER_BIN=~/.local/bin/piper
#NOVA_PIPER_VOICE=~/.local/share/piper/en_US-lessac-medium.onnx

# Listening
#NOVA_CONVERSE=1                  # keep listening for a follow-up after each reply
#NOVA_CONVERSE_TIMEOUT_S=8
#NOVA_VAD_SILENCE_MS=700          # trailing silence that ends your turn
#NOVA_VAD_START_TIMEOUT_S=20
#NOVA_MAX_RECORD_S=45
#NOVA_PAUSE_MEDIA=1               # pause playerctl media while a turn is in flight
#NOVA_MUTE=0
#NOVA_DEBUG=0
